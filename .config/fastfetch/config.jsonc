{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 2,
            "left": 2
        }
    },
    "display": {
        "separator": " ❯ "
    },
    "modules": [
        {
            "type": "title",
            "format": " {user-name-colored}",
            "key": "  "
        },
        "break",
        {
            "type": "os",
            "key": "󰣇 OS",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key": "󰒋 KO",
            "keyColor": "magenta"
        },
        {
            "type": "uptime",
            "key": "󰅐 UP",
            "keyColor": "cyan"
        },
        {
            "type": "packages",
            "key": "󰏖 PK",
            "keyColor": "yellow"
        },
        {
            "type": "gpu",
            "key": "󰢮 GP",
            "keyColor": "red"
        },
        {
            "type": "memory",
            "key": "󰍛 RM",
            "keyColor": "green"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
