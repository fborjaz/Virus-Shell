{
    "buttons" : [
        {
            "label" : "lock",
            "action" : "hyprlock",
            "text" : "Bloquear",
            "keybind" : "l"
        },
        {
            "label" : "suspend",
            "action" : "systemctl suspend",
            "text" : "Suspender",
            "keybind" : "u"
        },
        {
            "label" : "logout",
            "action" : "hyprctl dispatch exit 0",
            "text" : "Salir",
            "keybind" : "e"
        },
        {
            "label" : "shutdown",
            "action" : "systemctl poweroff",
            "text" : "Apagar",
            "keybind" : "s"
        },
        {
            "label" : "reboot",
            "action" : "systemctl reboot",
            "text" : "Reiniciar",
            "keybind" : "r"
        }
    ]
}
