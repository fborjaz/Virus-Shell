;; ##########################################################################
;; ##                           WIDGET DE LA BARRA                         ##
;; ##########################################################################

(defwidget bar []
    (box :class "bar"
         :orientation "h"
         (box :halign "start"
              :valign "center"
              :spacing 15
              :hexpand true
              :space-evenly false
              (menu)
              (workspaces)
              (net)
         )
         (box :halign "center"
              :valign "center"
              :spacing 15
              :hexpand true
              :orientation "h"
              (label :text "Virus ❯ " :style "color: #1793d1; font-weight: bold;")
              (weather)
              (divider)
              (time-widget)
         )
         (box :halign "end"
              :valign "center"
              :hexpand true
              :space-evenly false
              :spacing 10
              (box :space-evenly false
                   :spacing 10
                   (tray)
                   (volume)
                   (cpu_bar)
                   (ram)
                   (disk_bar)
                   (battery)
                   (keyboard)
              )
              (divider)
              (power)
         )
    )
)

;; ##########################################################################
;; ##                          WIDGETS DE MONITOREO                        ##
;; ##########################################################################

(defwidget net []
  (box :class "wifi" :space-evenly false :spacing 5
    (label :text "󰓅 ")
    (label :class "bsht" :text "${round(EWW_NET.enp3s0.NET_DOWN / 1024, 0)} KB/s")
  )
)

(defwidget cpu_bar []
  (box :class "cpu-short" :space-evenly false :spacing 5
    (label :class "cpu" :text " ")  
    (label :class "bsht" :text "${round(EWW_CPU.avg, 0)}%")
  )
)

(defwidget disk_bar []
  (box :class "disk-short" :space-evenly false :spacing 5
    (label :class "disk" :text " ")
    (label :class "bsht" :text "${round(EWW_DISK['/'].used_perc, 0)}%")
  )
)

(defwidget ram []
    (box :class "ram-short" :space-evenly false :spacing 5
         (label :class "ram" :text " ") 
         (label :class "bsht" :text "${round(EWW_RAM.used_mem_perc,0)}%")))

;; ##########################################################################
;; ##                             CLIMA                                    ##
;; ##########################################################################

(defpoll weather_data :interval "15m" :initial "󰖐 --°C" "curl -sf 'wttr.in/?format=%c+%t' || echo '󰖐 --°C'")

(defwidget weather []
  (box :class "weather" :space-evenly false :spacing 5
    (label :text "${weather_data}")
  )
)

;; ##########################################################################
;; ##                          AUDIO Y VOLUMEN                             ##
;; ##########################################################################

(defpoll vol_mute :interval "1s" "pamixer --get-mute")
(defpoll mic_mute :interval "1s" "pamixer --default-source --get-mute")
(defpoll get_vol :interval "1s" "pamixer --get-volume")

(defwidget volume []
  (box :class "volume-short" :spacing 8 :space-evenly false
    (eventbox :cursor "pointer" :onclick "pamixer --default-source -t"
      (label :text "${mic_mute == 'true' ? '󰍭' : '󰍬'}" 
             :style "color: ${mic_mute == 'true' ? '#f38ba8' : '#cdd6f4'};"))
    
    (eventbox :cursor "pointer" :onclick "pamixer -t"
      (box :space-evenly false
        (label :text "${vol_mute == 'true' ? '󰝟' : '󰕾'}" 
               :style "color: ${vol_mute == 'true' ? '#f38ba8' : '#cdd6f4'};")
        (label :class "bsht" :text " ${get_vol}%")
      ))
  )
)

;; ##########################################################################
;; ##                         TRABAJO Y ESCRITORIOS                        ##
;; ##########################################################################

(defwidget workspaces []
    (literal :content workspaces-output)
)

(deflisten workspaces-output :initial "(box)" "./scripts/workspaces.sh")

;; ##########################################################################
;; ##                        TRAY, TECLADO Y OTROS                         ##
;; ##########################################################################

(defvar trayrev false)
(defwidget tray []
    (box :orientation "h" :space-evenly false
         (revealer :reveal {trayrev} :transition "slideleft"
                   (box :class "systray-shadow"
                        (systray :space-evenly true :icon-size 16 :prepend-new true)))
         (eventbox :class "tray-button" :width 20
                   :onclick "eww update trayrev=${!trayrev}"
                   :cursor "pointer"
                   (label :class "tray-text" :text "${trayrev ? '›' : '‹'}"))))

(deflisten kb_layout :initial "EN" "./scripts/get_kb.sh")
(defwidget keyboard []
    (box :class "keyboard"
        (eventbox :onclick "hyprctl switchxkblayout at-translated-set-2-keyboard next"
                  :cursor "pointer"
                  (label :text "${kb_layout}"))))

(defwidget battery []
    (box :class "battery" :space-evenly false
         (label :class "BAT1" :text "󰁹 ")
         (label :class "bsht" :text "${EWW_BATTERY.BAT0.capacity}%")))

;; ##########################################################################
;; ##                        TIEMPO Y CALENDARIO                           ##
;; ##########################################################################

(defpoll get_time :interval "1s" "date '+%H:%M:%S'")
(defpoll get_date :interval "1m" "date '+%d.%m.%Y, %A'")
(defvar timerev false)

(defwidget time-widget []
  (eventbox :cursor "pointer"
            :onclick "eww update timerev=${!timerev}"
    (label :class "time-label" :text "${get_time}")
  )
)

;; ##########################################################################
;; ##                           VENTANA PRINCIPAL                          ##
;; ##########################################################################

(defwindow bar_widget
    :monitor 0
    :stacking "fg"
    :geometry (geometry :anchor "top center"
                        :width "99.5%"
                        :height "40px"
                        :y "5px") 
    :exclusive true
    (bar)
)

;; ##########################################################################
;; ##                        VENTANA DE CALENDARIO                         ##
;; ##########################################################################

(defwindow calendar_window
    :monitor 0
    :stacking "overlay"
    :geometry (geometry :anchor "top center"
                        :width "400px"
                        :y "55px")
    :focusable false
    (revealer :reveal timerev
              :transition "slidedown"
              :duration "300ms"
      (box :class "calendar-container" :orientation "v" :space-evenly false
        (box :class "time-box" :orientation "v" :space-evenly false
          (label :class "time-inner" :text "${get_time}")
          (label :class "date-inner" :text "${get_date}")
        )
        (box :class "calendar-box"
          (calendar :class "cal")
        )
      )
    )
)

;; ##########################################################################
;; ##                      VENTANA DE CONTROL DEL SISTEMA                  ##
;; ##########################################################################

(defvar powerrev false)

(defwindow power_menu
    :monitor 0
    :stacking "overlay"
    :geometry (geometry :anchor "top right"
                        :width "250px"
                        :x "-10px"
                        :y "55px")
    :focusable false
    (revealer :reveal powerrev
              :transition "slidedown"
              :duration "300ms"
      (box :class "main-container" :orientation "v" :space-evenly false :spacing 10
        (box :class "ctlpanel" :orientation "v" :spacing 15 :halign "center"
          (eventbox :cursor "pointer" :onclick "systemctl poweroff"
            (label :class "shutdown" :text "  Shutdown"))
          (eventbox :cursor "pointer" :onclick "systemctl reboot"
            (label :class "reboot" :text "  Reboot"))
          (eventbox :cursor "pointer" :onclick "hyprctl dispatch exit"
            (label :class "logout" :text "󰗼  Logout"))
          (eventbox :cursor "pointer" :onclick "swaylock"
            (label :class "lockscr" :text "  Lock"))
          (eventbox :cursor "pointer" :onclick "systemctl suspend"
            (label :class "suspend" :text "󰤄  Suspend"))
        )
      )
    )
)

;; ##########################################################################
;; ##                          WIDGETS AUXILIARES                          ##
;; ##########################################################################

(defwidget divider [] (label :class "div" :text "|"))

(defwidget menu [] 
  (eventbox :class "menu-eventbox" :cursor "pointer" :onclick "wofi --show drun &"
    (label :class "menu" :text " ")))

(defwidget power [] 
  (eventbox :class "power-eventbox" :cursor "pointer" :onclick "eww update powerrev=${!powerrev}"
    (label :class "power" :text "󰻃 ")))